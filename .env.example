# =========================================================
# JARVIS Environment Configuration (example)
# Copy this file to ".env" and adjust values as needed.
# =========================================================

# Application
APP_ENV=development
APP_NAME=JARVIS
APP_LOG_LEVEL=info

# Database
DB_FILENAME=jarvis.sqlite
DB_DIRECTORY=./database

# Logging
LOG_DIRECTORY=./logs
LOG_TO_FILE=true
LOG_TO_CONSOLE=true

# Window
WINDOW_WIDTH=1280
WINDOW_HEIGHT=800
WINDOW_DEV_TOOLS=true

# Renderer (development only)
VITE_DEV_SERVER_URL=http://127.0.0.1:5173

# Core Infrastructure (Communication Bus / Health Monitor defaults)
INFRA_COMMAND_TIMEOUT_MS=5000
INFRA_MAX_RETRY_ATTEMPTS=3
INFRA_RETRY_BACKOFF_BASE_MS=250
INFRA_HEALTH_POLL_INTERVAL_MS=15000
INFRA_MAX_CONSECUTIVE_FAILURES=3

# Audio Pipeline Architecture (no capture/playback happens yet — structural only)
AUDIO_SAMPLE_RATE_HZ=16000
AUDIO_CHANNELS=1
AUDIO_BIT_DEPTH=16
AUDIO_BUFFER_CAPACITY=50
AUDIO_MAX_CONCURRENT_SESSIONS=1
AUDIO_DEFAULT_LANGUAGE=en-US
AUDIO_NOISE_REDUCTION_ENABLED=false
AUDIO_ECHO_CANCELLATION_ENABLED=false

# Voice Runtime Framework (orchestration only — no provider connected yet)
VOICE_RUNTIME_SESSION_TIMEOUT_MS=30000
VOICE_RUNTIME_MAX_RETRY_ATTEMPTS=3
VOICE_RUNTIME_RETRY_BACKOFF_BASE_MS=250

# Voice Provider Architecture (M3.1) — architecture only, no TTS engine connected
VOICE_PROVIDER_DEFAULT_GENDER=female
VOICE_PROVIDER_DEFAULT_LANGUAGE=en-US
VOICE_PROVIDER_FALLBACK_ENABLED=true
# VOICE_PROVIDER_PREFERRED_PROVIDER_ID=

# Speech-to-Text Architecture (M3.2) — architecture only, no STT engine connected
SPEECH_TO_TEXT_DEFAULT_LANGUAGE=en-US
SPEECH_TO_TEXT_AUTO_DETECT_LANGUAGE=false
SPEECH_TO_TEXT_STREAMING_ENABLED=true
SPEECH_TO_TEXT_SUPPORTED_LANGUAGES=en-US,sw-KE

# Wake Word Architecture (M3.3) — architecture only, no wake-word engine connected
WAKE_WORD_DEFAULT_WAKE_WORD=Jarvis
WAKE_WORD_SENSITIVITY=0.5
WAKE_WORD_CONFIDENCE_THRESHOLD=0.6
WAKE_WORD_COOLDOWN_MS=1500
WAKE_WORD_SECURE_WAKE_ENABLED=false

# =========================================================
# AI Orchestration (M5.1) — provider adapters activate when a key is supplied.
# Enabled flags are true by default; a missing API key still keeps that provider unavailable.
# Keys are read ONLY on the backend (AppBootstrapper) and are never sent
# to the renderer or written into config/app.config.json.
# =========================================================

# Preferred provider override (optional). Leave unset to use the
# per-task-type priority order defined in config/app.config.json.
# AI_PROVIDER_PRIMARY=openai
AI_CONTEXT_MAX_TURNS=12
AI_CONTEXT_MAX_CHARS=8000

# OpenAI
OPENAI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=20000

# Google Gemini
# NOTE (V7.2): gemini-2.5-flash is restricted for newer projects. gemini-3.8-flash is
# the current stable GA flash model — double check
# https://ai.google.dev/gemini-api/docs/models before changing this if
# you see a 404, since Gemini model names drift every few months.
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=20000
# When GEMINI_MODEL 404s, query Gemini's models.list once for a working
# replacement instead of just failing (see docs/AI_PROVIDERS.md). Sends
# one extra request only after a real failure — never at startup.
GEMINI_MODEL_DISCOVERY_ENABLED=true

# Anthropic Claude
CLAUDE_ENABLED=true
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
# CLAUDE_BASE_URL=https://api.anthropic.com/v1
CLAUDE_TIMEOUT_MS=20000
CLAUDE_MAX_TOKENS=4096
# Only needed for a workspace-scoped gateway such as Claude Platform on
# AWS (sent as the anthropic-workspace-id header). A normal
# api.anthropic.com key is already scoped to a workspace server-side and
# does NOT need this set.
# ANTHROPIC_WORKSPACE_ID=

# Groq (https://api.groq.com/openai/v1 — OpenAI-compatible, LPU inference).
# Check https://console.groq.com/docs/models for the current free-tier
# model line-up before relying on the default below long-term.
GROQ_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=20000

# Lovable AI Gateway (https://ai.gateway.lovable.dev/v1 — OpenAI-compatible).
# Model ids are namespaced, e.g. google/gemini-3.7-flash or
# openai/gpt-5-mini — see docs/AI_PROVIDERS.md. No default model is set
# here on purpose: leaving LOVABLE_MODEL blank keeps this provider
# disabled (isConfigured() = false) until you pick one from your own
# Lovable project's catalog, since availability/pricing tiers are
# managed on Lovable's side and can change independently of JARVIS.
LOVABLE_ENABLED=true
LOVABLE_API_KEY=
LOVABLE_MODEL=
LOVABLE_BASE_URL=https://ai.gateway.lovable.dev/v1
LOVABLE_TIMEOUT_MS=20000

# OpenRouter (https://openrouter.ai/api/v1 — OpenAI-compatible, 400+ models).
# Same reasoning as Lovable above: no default model, since the "right"
# one depends entirely on which of OpenRouter's many models you want and
# whether it needs to support tool/function calling.
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=20000


# Agent/tool execution
JARVIS_TOOL_LOOP_MAX_ROUNDS=8
JARVIS_VISION_ENABLED=true
JARVIS_APP_DISCOVERY_ENABLED=true
JARVIS_OFFICE_AUTOMATION_ENABLED=true

# =========================================================
# Stage 7 — Personal Integrations (names only; never commit real values)
# Secrets are read ONLY by the Electron main process. OAuth tokens are NOT
# stored here: after you click Connect they are encrypted with Windows
# DPAPI (Electron safeStorage) under the app's userData folder.
# Setup: docs/INTEGRATIONS.md, docs/GMAIL.md, docs/GOOGLE_CALENDAR.md
# =========================================================

# Gmail + Google Calendar (Google Cloud "Desktop app" OAuth client)
GMAIL_ENABLED=
CALENDAR_ENABLED=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Not implemented in this release (names reserved for the next Stage 7 delivery)
# DRIVE_ENABLED=
# WHATSAPP_ENABLED=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_VERSION=
# MICROSOFT_ENABLED=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# OUTLOOK_ENABLED=
# ONEDRIVE_ENABLED=
# TELEGRAM_ENABLED=
# DISCORD_ENABLED=
